# Downloaded audio (user data, large; regenerated at runtime)
music/*
!music/tracks.json

# Python virtual environment (regenerated by host/install.py)
host/venv/

# Native host runtime logs
host/host.log
host/sh_stderr.log
host/*.log
host/venv_yt_dlp_output.txt

# Bundled yt-dlp binary + stray downloaded audio in host/ (regenerated/user data)
host/yt-dlp
host/*.m4a
host/*.mp3

# Debug server artifacts
.dbg/
debug-*.md
trae-debug-log-*.ndjson

# Python caches
__pycache__/
*.pyc

# macOS
.DS_Store

# Editor/OS cruft
*.swp
